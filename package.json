{
  "name": "support-bot",
  "version": "1.0.0",
  "description": "Telegram support bot (grammY port of the aiogram bot)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "export:history": "tsx scripts/exportHistory.ts",
    "kb:parse": "tsx scripts/parseExport.ts",
    "kb:build": "tsx scripts/buildKnowledgeBase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@grammyjs/parse-mode": "^1.10.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/storage-redis": "^2.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "input": "^1.0.1",
    "telegram": "^2.26.22",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
